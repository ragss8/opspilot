# ---------------------------------------------------------------- API server
PORT=4000
WEB_ORIGIN=http://localhost:5173

# Optional. When set, every non-health route requires an `x-api-key` header.
# Leave empty to run the demo with no authentication.
OPSPILOT_API_KEY=

# ------------------------------------------------------------- AI provider
# local | openai | aws. Local mode is deterministic and requires no credentials.
AI_PROVIDER=local

# When false, a hosted provider failure surfaces as an error instead of
# silently degrading to the local engine. Set false in production.
AI_ALLOW_FALLBACK=true

# ------------------------------------------------------------------- OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# -------------------------------------------------------------- AWS Bedrock
# Credentials come from the standard AWS SDK credential chain.
AWS_REGION=us-east-1
AWS_BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
AWS_BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
AWS_BEDROCK_EMBEDDING_DIMENSIONS=1024

# ------------------------------------------------------------ Cost tracking
# Override the built-in rate card as "inputPerMillion,outputPerMillion".
# The defaults in src/ai/usage.ts are a starting point, not a live price feed:
# verify them against the provider's current pricing before relying on cost.
# OPSPILOT_PRICE_GPT_5_MINI=0.25,2.00
# OPSPILOT_PRICE_AMAZON_NOVA_LITE_V1_0=0.06,0.24
