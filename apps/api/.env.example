# The repository root .env.example is the documented reference. This file is
# loaded afterwards and only fills values the root file did not set, so use it
# for API-specific overrides during local development.

PORT=4000
WEB_ORIGIN=http://localhost:5173

# local (default), openai, or aws
AI_PROVIDER=local
AI_ALLOW_FALLBACK=true

# Optional: when set, every non-health route requires an x-api-key header.
OPSPILOT_API_KEY=

OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MODEL=gpt-5-mini

# Used only when AI_PROVIDER=aws. Credentials use the AWS SDK default chain.
AWS_REGION=us-east-1
AWS_BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
AWS_BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
AWS_BEDROCK_EMBEDDING_DIMENSIONS=1024
