{
  "name": "opspilot-ai",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered fleet operations copilot with RAG, semantic search, classification, and summarization.",
  "packageManager": "pnpm@11.0.8",
  "scripts": {
    "dev": "pnpm --parallel --filter @opspilot/api --filter @opspilot/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "eval": "pnpm --filter @opspilot/api eval"
  },
  "engines": {
    "node": ">=20"
  }
}
